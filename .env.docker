# Docker Environment Configuration
# Copy this file to .env.docker.local and fill in your values

# Database Configuration
DB_USER=marqdex
DB_PASSWORD=your_secure_password_here
DB_NAME=marqdex

# Application Port
APP_PORT=3000

# NextAuth Configuration
# Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Encryption Key (must be 32+ characters)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your_encryption_key_here

# Email Configuration (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=MarqDex <your-email@gmail.com>

# Liveblocks Configuration (optional)
# LIVEBLOCKS_SECRET=sk_liveblocks_your_secret
# LIVEBLOCKS_PUBLIC_KEY=pk_liveblocks_your_public_key

# App Configuration
APP_NAME=MarqDex
APP_URL=http://localhost:3000
