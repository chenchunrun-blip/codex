# =============================================================================
# Development / POC Environment Variables
# =============================================================================
# Copy this file to .env before running docker compose:
#   cp .env.dev .env
#
# Then customize any values you need (especially LLM API keys).
# =============================================================================

# ---------------------------------------------------------------------------
# Infrastructure passwords (change in production!)
# ---------------------------------------------------------------------------
DB_PASSWORD=dev_password
REDIS_PASSWORD=dev_password
RABBITMQ_PASSWORD=dev_password

# ---------------------------------------------------------------------------
# Infrastructure ports (change if conflicts with local services)
# ---------------------------------------------------------------------------
POSTGRES_PORT=5434
REDIS_PORT=6381
RABBITMQ_PORT=5673
RABBITMQ_MGMT_PORT=15673
CHROMA_PORT=8001

# ---------------------------------------------------------------------------
# LLM / MaaS Configuration
# ---------------------------------------------------------------------------
# Option 1: Qwen (Aliyun DashScope) — recommended for China
#LLM_API_KEY=sk-your-qwen-api-key
#LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Option 2: OpenAI
#LLM_API_KEY=sk-your-openai-key
#LLM_BASE_URL=https://api.openai.com/v1

# Option 3: Private MaaS (DeepSeek + Qwen)
DEEPSEEK_BASE_URL=http://internal-maas.deepseek/v1
DEEPSEEK_API_KEY=mock-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=mock-key

# ---------------------------------------------------------------------------
# Threat Intel API keys (use "mock" for dev)
# ---------------------------------------------------------------------------
VIRUSTOTAL_API_KEY=mock
ABUSECH_API_KEY=mock

# ---------------------------------------------------------------------------
# Application settings
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=dev-secret-key-not-for-production
LOG_LEVEL=DEBUG
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Monitoring (only used with --profile monitoring)
# ---------------------------------------------------------------------------
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090

# ---------------------------------------------------------------------------
# Notification channels (dev stubs)
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=dev@localhost
SMTP_PASSWORD=dev
SLACK_WEBHOOK_URL=http://localhost/noop
