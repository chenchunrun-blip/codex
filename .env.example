# ===========================================
# MarqDex Environment Configuration
# ===========================================
# Copy this file to .env and update values as needed
# NEVER commit .env files to version control

# ===========================================
# Database Configuration
# ===========================================
DATABASE_URL="postgresql://user:password@localhost:5432/marqdex?schema=public"

# ===========================================
# Authentication (NextAuth.js v5)
# ===========================================
# Generate secure secrets with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="<GENERATE_WITH: openssl rand -base64 32>"

# ===========================================
# Encryption Configuration
# ===========================================
# Used for encrypting sensitive data like API keys
# Must be at least 32 characters
ENCRYPTION_KEY="<GENERATE_WITH: openssl rand -base64 32>"

# Unique salt for encryption key derivation
# Must be at least 16 characters
# Generate with: openssl rand -hex 16
ENCRYPTION_SALT="<GENERATE_WITH: openssl rand -hex 16>"

# ===========================================
# MCP (Model Context Protocol) Configuration
# ===========================================
# Allowed origins for MCP CORS (comma-separated)
# Use full URLs without trailing slashes
MCP_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# ===========================================
# Liveblocks Configuration (Optional)
# ===========================================
# For real-time collaboration features
# Get keys from: https://liveblocks.io
LIVEBLOCKS_SECRET=""

# ===========================================
# Email Configuration
# ===========================================
# Choose one provider or configure SMTP manually

# Gmail Configuration:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM_NAME="MarqDex"
# SMTP_FROM_EMAIL="your-email@gmail.com"

# Outlook Configuration:
# SMTP_HOST="smtp.office365.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-email@outlook.com"
# SMTP_PASS="your-password"
# SMTP_FROM_NAME="MarqDex"
# SMTP_FROM_EMAIL="your-email@outlook.com"

# ===========================================
# AI Configuration (Optional)
# ===========================================
# Default AI model for content generation
# Users can configure their own API keys in settings
# AI_DEFAULT_MODEL="gpt-3.5-turbo"

# ===========================================
# Application Configuration
# ===========================================
APP_NAME="MarqDex"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ===========================================
# Rate Limiting (Production)
# ===========================================
# For production, consider using Redis-backed rate limiting
# REDIS_URL="redis://localhost:6379"

# ===========================================
# Security Headers (Production)
# ===========================================
# Additional allowed origins for CORS
# CORS_ALLOWED_ORIGINS="https://yourdomain.com,https://app.yourdomain.com"
