{
  "name": "marqdex",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "author": "chenchunrun <https://github.com/chenchunrun>",
  "description": "MarqDex - AI-Powered Collaborative Workspace for Markdown Document Editing",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit:core": "jest tests/project-options-cache.test.ts tests/team-options-cache.test.ts tests/template-options-cache.test.ts tests/starter-pack-options-cache.test.ts tests/report-api-error.test.ts tests/task-api-error.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:line": "playwright test --reporter=line",
    "test:e2e:smoke": "playwright test --reporter=line e2e/auth.spec.ts e2e/operations-status.spec.ts",
    "test:e2e:workspace": "playwright test --reporter=line e2e/workspace-core-flows.spec.ts",
    "test:e2e:team": "playwright test --reporter=line e2e/team-rollout-flows.spec.ts",
    "test:e2e:team-members": "playwright test --reporter=line e2e/team-members-resilience.spec.ts",
    "test:e2e:queue": "playwright test --reporter=line e2e/agent-queue-console.spec.ts",
    "test:e2e:ops": "playwright test --reporter=line e2e/task-operations-retry.spec.ts",
    "test:e2e:onboarding": "playwright test --reporter=line e2e/onboarding-empty-workspace.spec.ts",
    "test:e2e:review": "playwright test --reporter=line e2e/review-queue-priority.spec.ts",
    "verify:core": "npm run typecheck && npm run test:unit:core && npm run test:e2e:smoke",
    "verify:mainline": "npm run test:e2e:review && npm run test:e2e:workspace && npm run test:e2e:team && npx playwright test --reporter=line e2e/collab-core-flow.spec.ts",
    "verify:extended": "npm run verify:core && npm run test:e2e:workspace && npm run test:e2e:team && npm run test:e2e:review && npx playwright test --reporter=line e2e/collab-core-flow.spec.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "mcp:server": "tsx mcp-server/sse-server.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@liveblocks/client": "^3.13.3",
    "@liveblocks/node": "^3.13.3",
    "@liveblocks/react": "^3.13.3",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "7.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "highlight.js": "^11.11.1",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.11.0",
    "marked": "^17.0.1",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "nodemailer": "^7.0.13",
    "openai": "^6.16.0",
    "pg": "^8.17.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/marked": "^5.0.2",
    "@types/node": "^20.19.37",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jest": "^30.2.0",
    "node-mocks-http": "^1.17.2",
    "prisma": "^7.3.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
